# Rename this file to .env.local and fill in your values
# Get these from your Supabase project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry project DSN — leave blank to disable crash reporting
NEXT_PUBLIC_SENTRY_DSN=

# PostHog project API key + host — leave blank to disable analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server only (never prefix with NEXT_PUBLIC_). Used by /api/admin/* to manage
# partners, rewards, code pools, reports and campaigns after checking the
# caller is an admin. Supabase project → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
