# ============================================================
# Runivo — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit real keys.
# ============================================================

# Supabase project URL (Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth — read by the Supabase Auth *server* (supabase/config.toml's
# env(...) substitution), not the app directly. Must be exported in your shell
# (or present in this file, loaded via `set -a; source .env.local; set +a`)
# before running `supabase start`, since the CLI reads config.toml env(...)
# refs from the process environment. Create an OAuth client in Google Cloud
# Console (type "Web application"); authorized redirect URI is
# <SUPABASE_URL>/auth/v1/callback (for local: http://127.0.0.1:54321/auth/v1/callback).
# For the hosted/production project, set these in Supabase Dashboard →
# Authentication → Providers → Google instead — this file only governs local dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret

# ── Stripe (optional — leave blank to show placeholder alert) ──────────────────
VITE_STRIPE_LINK_RUNNER_PLUS=
VITE_STRIPE_LINK_TERRITORY_LORD=
VITE_STRIPE_LINK_EMPIRE_BUILDER=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a VAPID key pair once: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY is safe to expose to the client (it's a public key).
# Add VAPID_PRIVATE_KEY + VAPID_SUBJECT to Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# ── Sentry (crash reporting) ─────────────────────────────────────────────────
# Create a project at sentry.io, then copy the DSN from Settings > Client Keys.
# Leave blank in development to disable error reporting.
VITE_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# ── PostHog (product analytics) ───────────────────────────────────────────────
# Create a project at posthog.com, then copy the key from Project Settings.
# Read by apps/mobile/App.tsx (initAnalytics) — leave blank to disable tracking.
# Must also be set in apps/mobile/eas.json's build.preview/production.env for
# real builds; process.env alone does not reach an EAS build.
EXPO_PUBLIC_POSTHOG_API_KEY=

# ── RevenueCat (subscriptions) ────────────────────────────────────────────────
# Create a project at revenuecat.com, add the runivo_plus_monthly/annual
# products under an offering named "default", then copy the iOS/Android
# public API keys from Project Settings > API Keys. Leave blank in development
# to fall back to a safe no-op (see purchaseService.ts) — the paywall UI still
# renders, purchases just can't complete.
# Must also be set in apps/mobile/eas.json's build.preview/production.env for
# real builds; process.env alone does not reach an EAS build.
EXPO_PUBLIC_RC_API_KEY_IOS=
EXPO_PUBLIC_RC_API_KEY_ANDROID=

# ── Runivo Intelligence (AI Coach) ────────────────────────────────────────────
# The Anthropic API key is used SERVER-SIDE ONLY in the ai-coach Supabase edge
# function. It is NEVER exposed to the client.
# Add this key in Supabase Dashboard > Edge Functions > Secrets:
#   Key: ANTHROPIC_API_KEY
#   Value: sk-ant-api03-...
#
# For local edge function development (supabase functions serve):
# Add to supabase/functions/.env (git-ignored):
#   ANTHROPIC_API_KEY=sk-ant-api03-...
